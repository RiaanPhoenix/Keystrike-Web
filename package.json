{
  "name": "keystrike-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:analyze": "node scripts/build-and-analyze.js",
    "test:deployment": "node scripts/test-deployment.js",
    "test:prod": "npm run build && npm run start & sleep 5 && npm run test:deployment http://localhost:3000 && pkill -f 'next start'",
    "deploy:check": "npm run lint && npm run build:analyze && npm run test:deployment"
  },
  "dependencies": {
    "critters": "^0.0.23",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
